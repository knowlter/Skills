{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/knowlter/Skills/schemas/site.schema.json",
  "title": "Knowlter Skills Site",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site", "maintenance", "limits", "errors"],
  "properties": {
    "schema_version": { "const": 1 },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "country", "locale", "base_url", "allowed_hosts", "access"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "locale": { "type": "string", "minLength": 2 },
        "base_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "allowed_hosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "access": { "enum": ["public", "authentication-required"] }
      }
    },
    "maintenance": {
      "type": "object",
      "required": ["status", "last_verified", "verification_mode", "owners", "known_limits"],
      "properties": {
        "status": { "enum": ["experimental", "verified", "broken", "unmaintained"] },
        "last_verified": { "type": "string", "format": "date" },
        "verification_mode": { "enum": ["design-only", "fixture-only", "live", "browser-required", "broken"] },
        "owners": { "type": "array", "items": { "type": "string" } },
        "known_limits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "session": { "type": "object" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concurrency", "requests_per_second", "timeout_seconds", "retries"],
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1 },
        "requests_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "retries": { "type": "integer", "minimum": 0 }
      }
    },
    "errors": {
      "type": "object",
      "required": ["challenge_patterns", "status_map"],
      "properties": {
        "challenge_patterns": { "type": "array", "items": { "type": "string" } },
        "status_map": { "type": "object", "additionalProperties": { "$ref": "error.schema.json" } }
      }
    }
  }
}
